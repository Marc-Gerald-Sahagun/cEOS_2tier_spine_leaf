! Command: show running-config at line 1
! device: leaf2 (cEOSLab, EOS-4.32.0F-36401836.4320F (engineering build))
!
no aaa root
!
username admin privilege 15 role network-admin secret sha512 $6$uo2MDR427D9WAMcV$t7TkSJEh/XvgLH7XLF7MGLu6uM1j/2SOJyqSLdzjJR2RLpnz7amtcdKjWkOHKGZAIKTx5MmZoLN6rewdHGdUO/
!
dhcp server
   subnet 10.10.1.0/28
      range 10.10.1.9 10.10.1.14
      default-gateway 10.10.1.1
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname leaf2
!
spanning-tree mode mstp
no spanning-tree vlan-id 4094
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vlan 10
!
vlan 4094
   trunk group MLAGPEER
!
management api http-commands
   no shutdown
!
interface Port-Channel10
   switchport access vlan 10
   mlag 10
!
interface Port-Channel1000
   description MLAG peer link
   switchport mode trunk
   switchport trunk group MLAGPEER
!
interface Ethernet1
   description to spine1
   no switchport
   ip address 10.1.1.3/31
!
interface Ethernet2
   description to spine2
   no switchport
   ip address 10.1.2.3/31
!
interface Ethernet3
   description to server
   channel-group 10 mode active
!
interface Ethernet4
   description MLAG peer link
   channel-group 1000 mode active
!
interface Loopback0
   ip address 10.0.1.2/32
!
interface Management0
   ip address 10.0.20.102/24
!
interface Vlan10
   ip address 10.10.1.3/28
   dhcp server ipv4
   ip virtual-router address 10.10.1.1
!
interface Vlan4094
   ip address 10.255.255.2/30
!
ip virtual-router mac-address 00:1c:73:00:00:99
!
ip routing
!
mlag configuration
   domain-id LEAFPAIR1
   local-interface Vlan4094
   peer-address 10.255.255.1
   peer-link Port-Channel1000
!
router bgp 65102
   router-id 10.0.1.2
   maximum-paths 2
   neighbor 10.1.1.2 remote-as 65100
   neighbor 10.1.2.2 remote-as 65100
   network 10.10.1.0/28
!
end
