! Command: show running-config at line 1
! device: leaf5 (cEOSLab, EOS-4.32.0F-36401836.4320F (engineering build))
!
no aaa root
!
username admin privilege 15 role network-admin secret sha512 $6$u1P8kf.UR1e9OK8S$VTLATe4U6QhPqA9FB60MsI7866ZmbJC0wHdyaL3/WU8tC72PVbQ9AVaSx87/KfoEaghflV0p8GdNP/gx7pxdo/
!
dhcp server
   subnet 10.10.3.0/28
      range 10.10.3.3 10.10.3.14
      default-gateway 10.10.3.2
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname leaf5
!
spanning-tree mode mstp
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vlan 30
!
management api http-commands
   no shutdown
!
interface Port-Channel10
   description server3 bundle
   switchport access vlan 30
!
interface Ethernet1
   description to spine1
   no switchport
   ip address 10.1.1.9/31
!
interface Ethernet2
   description to spine2
   no switchport
   ip address 10.1.2.9/31
!
interface Ethernet3
   description to server
   channel-group 10 mode active
!
interface Ethernet4
   description to server 3
   channel-group 10 mode active
!
interface Loopback0
   ip address 10.0.1.5/32
!
interface Management0
   ip address 10.0.20.105/24
!
interface Vlan30
   ip address 10.10.3.2/28
   dhcp server ipv4
!
ip routing
!
router bgp 65105
   router-id 10.0.1.5
   maximum-paths 2
   neighbor 10.1.1.8 remote-as 65100
   neighbor 10.1.2.8 remote-as 65100
   network 10.0.1.5/32
   network 10.10.3.0/28
!
end
