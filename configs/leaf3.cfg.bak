! Command: show running-config at line 1
! device: leaf3 (cEOSLab, EOS-4.32.0F-36401836.4320F (engineering build))
!
no aaa root
!
username admin privilege 15 role network-admin secret sha512 $6$ELOc4.69udt94lwP$liGWZ4rL2ozctfBfJJm/tlK4c51G1E8dO02QCuHqwfJHsmvcI850qKCGyqI6nFK9QltWULGR716SQ2XjD5QQQ0
!
dhcp server
   subnet 10.10.2.0/28
      range 10.10.2.4 10.10.2.8
      default-gateway 10.10.2.1
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname leaf3
!
spanning-tree mode mstp
no spanning-tree vlan-id 4094
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vlan 20
!
vlan 4094
   trunk group MLAGPEER
!
management api http-commands
   no shutdown
!
interface Port-Channel10
   switchport access vlan 20
   mlag 10
!
interface Port-Channel1000
   description MLAG peer link
   switchport mode trunk
   switchport trunk group MLAGPEER
!
interface Ethernet1
   description to spine1
   no switchport
   ip address 10.1.1.5/31
!
interface Ethernet2
   description to spine2
   no switchport
   ip address 10.1.2.5/31
!
interface Ethernet3
   description to server
   channel-group 10 mode active
!
interface Ethernet4
   description MLAG peer link
   channel-group 1000 mode active
!
interface Loopback0
   ip address 10.0.1.3/32
!
interface Management0
   ip address 10.0.20.103/24
!
interface Vlan20
   ip address 10.10.2.2/28
   dhcp server ipv4
   ip virtual-router address 10.10.2.1
!
interface Vlan4094
   ip address 10.255.255.5/30
!
ip virtual-router mac-address 00:1c:73:00:00:98
!
ip routing
!
mlag configuration
   domain-id LEAFPAIR2
   local-interface Vlan4094
   peer-address 10.255.255.6
   peer-link Port-Channel1000
!
router bgp 65103
   router-id 10.0.1.3
   neighbor 10.1.1.4 remote-as 65100
   neighbor 10.1.2.4 remote-as 65100
   network 10.10.2.0/28
!
end
